# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local, full-resolution design/reference photography. Optimized web assets live in public/.
/design-references/source-images/
# Ignore DOS 8.3 aliases supplied alongside the canonical reference files.
/design-references/outputs/*~*

# Impeccable design-review working directory. Comps, screenshots, and hook
# cache are local tooling scratch space (large binaries, regenerable) — kept
# out of the repo. The surface docs that record the actual design decisions
# are small and tracked normally.
/.impeccable/mocks/
/.impeccable/shots/
/.impeccable/hook.cache.json
